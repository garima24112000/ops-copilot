# Copy to .env and fill in local/free values. Never commit .env.
# All providers below must be usable on a genuinely free tier — no card on file.

# --- Elasticsearch / Kibana / APM (self-hosted via docker-compose) ---
ELASTIC_PASSWORD=changeme_local_only
KIBANA_SYSTEM_PASSWORD=changeme_local_only_too
KIBANA_ENCRYPTION_KEY=a_32_char_minimum_local_dev_key_x
ELASTICSEARCH_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601
APM_SERVER_URL=http://localhost:8200

# --- LLM providers (free tiers only) ---
# Reasoning: Google AI Studio (Gemini Flash) — no card required
GOOGLE_API_KEY=

# Fast/short calls: Groq free tier
GROQ_API_KEY=

# Bulk generation: Ollama, local
OLLAMA_BASE_URL=http://localhost:11434

# Backup providers (free-tier only, do not add payment top-ups)
CEREBRAS_API_KEY=
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
